<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SoccerAnalyzer.LinkDialog"
        Title="Open video from a link" Icon="/Assets/SoccerAnalyzer.ico" Width="620" Height="380" WindowStartupLocation="CenterOwner" CanResize="False">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="Video link (YouTube or any site yt-dlp supports)" FontWeight="SemiBold"/>
    <TextBox x:Name="UrlBox" Watermark="https://www.youtube.com/watch?v=..."/>
    <TextBlock Text="Save to folder" FontWeight="SemiBold"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox x:Name="FolderBox" Width="460"/>
      <Button x:Name="BrowseBtn" Content="Browse..."/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Maximum quality" VerticalAlignment="Center"/>
      <ComboBox x:Name="QualityBox" Width="120"/>
    </StackPanel>
    <TextBlock x:Name="ToolInfo" TextWrapping="Wrap" Opacity="0.85"/>
    <Button x:Name="FindToolBtn" Content="Browse for yt-dlp.exe..." HorizontalAlignment="Left"/>
    <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="10"/>
    <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="StartBtn" Content="Download and open"/>
      <Button x:Name="CloseBtn" Content="Close"/>
    </StackPanel>
  </StackPanel>
</Window>
